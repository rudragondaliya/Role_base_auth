<%- include('../partials/header') %>
<div class="page-wrapper">
  <div class="container-fluid">
    <h2 class="text-black mt-4">👑 Admin Dashboard</h2>
    <p class="text-muted">Welcome, <%= user.name %> (<%= user.role %>)</p>

    <div class="card mt-4">
      <div class="card-body">
        <h4>Manage Users</h4>
        <a href="/admin/create" class="btn btn-success mb-3">➕ Create New User</a>
        <table class="table table-striped text-black">
          <thead>
            <tr>
              <th>Name</th>
              <th>Email</th>
              <th>Role</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody>
            <% if (users && users.length) { %>
              <% users.forEach(u => { %>
                <tr>
                  <td><%= u.name %></td>
                  <td><%= u.email %></td>
                  <td><%= u.role %></td>
                  <td>
                   <a href="/admin/edit/<%= u._id %>" class="btn btn-warning btn-sm">Edit</a>
                    <a href="/admin/delete/<%= u._id %>" class="btn btn-danger btn-sm">Delete</a>

                  </td>
                </tr>
              <% }) %>
            <% } else { %>
              <tr><td colspan="4" class="text-center text-muted">No users found</td></tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>
<%- include('../partials/footer') %>
